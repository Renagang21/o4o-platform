    },
    {
      "id": "EXPALL-10",
      "gate": "재실행 시 완료 master 자동 skip"
    },
    {
      "id": "EXPALL-11",
      "gate": "예외 원장 누락·중복 0"
    },
    {
      "id": "EXPALL-12",
