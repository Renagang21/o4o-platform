# Exact known hosts only. Cloud Run probe / unknown hosts keep the O4O default.
map $host $seo_profile {
    default main;
    supplier.neture.co.kr supplier;
    funding.neture.co.kr funding;
    community.neture.co.kr community;
    carepharm.neture.co.kr carepharm;
}

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    charset utf-8;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = / {
        rewrite ^ /__seo/$seo_profile-home.html last;
    }
    location = /index.html {
        rewrite ^ /__seo/$seo_profile-home.html last;
    }
    # These build artifacts are only reachable via internal host selection.
    location ^~ /__seo/ {
        internal;
        add_header Cache-Control "no-cache" always;
        add_header Vary "Host" always;
        try_files $uri =404;
    }
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    # A missing static file must be a 404, never a successful HTML SPA response.
    location ~* \.(?:js|mjs|css|map|json|png|jpe?g|gif|svg|ico|webp|avif|woff2?|ttf|txt|xml|pdf)$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri @spa;
        add_header Cache-Control "no-cache" always;
    }
    location @spa {
        rewrite ^ /__seo/$seo_profile-spa.html last;
    }
}
