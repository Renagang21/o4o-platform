{
  "name": "@o4o/web-partner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3011 --strictPort",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
