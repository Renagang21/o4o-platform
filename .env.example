# Database Configuration
# 실행 절차: SETUP.md
#
# 로컬 개발 DB 와 운영 DB 접근 경로는 분리한다.
#   - 로컬 PostgreSQL      : 127.0.0.1:5432  (기본값)
#   - Cloud SQL Auth Proxy : 127.0.0.1:5442  (운영 DB 접근 전용)
# 개발 모드에서 운영 DB host 로 직접 TCP 연결하는 것은 차단된다.
# 운영 DB 는 반드시 프록시를 경유한다 (start-cloud-sql-proxy.cmd).

# --- (A) 로컬 개발 DB — 기본값 ---
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=o4o_user
DB_PASSWORD=your_local_db_password_here
DB_NAME=o4o_platform

# --- (B) 운영 DB 를 프록시로 읽을 때 ---
# 위 (A) 대신 아래 값을 사용한다. 비밀번호는 커밋하지 않는다.
#   DB_HOST=127.0.0.1
#   DB_PORT=5442
#   DB_USERNAME=<cloud sql user>
#   DB_PASSWORD=<cloud sql password>
#   DB_NAME=o4o_platform
# 사전 조건: gcloud auth application-default login  +  start-cloud-sql-proxy.cmd

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=CHANGE_THIS_IN_PRODUCTION
REFRESH_TOKEN_EXPIRES_IN=30d

# Server Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# TossPayments Configuration
TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
TOSS_API_URL=https://api.tosspayments.com/v1
TOSS_WEBHOOK_SECRET=your-webhook-secret

# Payment Gateway Settings
PAYMENT_SUCCESS_URL=http://localhost:3000/payment/success
PAYMENT_FAIL_URL=http://localhost:3000/payment/fail
PAYMENT_WEBHOOK_URL=http://localhost:3001/api/v1/toss-payments/webhook

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@o4o-platform.com

# AWS S3 Configuration (for file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=o4o-platform-uploads

# Monitoring
SENTRY_DSN=
LOG_LEVEL=info
ENABLE_METRICS=true

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
SESSION_SECRET=your-session-secret-change-this
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Features Toggle
ENABLE_BETA_FEATURES=false
ENABLE_MAINTENANCE_MODE=false
ENABLE_DEBUG_MODE=false