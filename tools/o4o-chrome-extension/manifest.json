{
  "manifest_version": 3,
  "name": "O4O Work Agent Bridge",
  "version": "0.0.2",
  "description": "O4O 로컬 작업 에이전트와 Chrome 을 연결하는 공식 브리지. 웹 자동화 전 환경검사와 작업 화면 모드를 제공합니다.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/side-panel.html"
  },
  "action": {
    "default_title": "O4O 작업 준비"
  },
  "permissions": ["sidePanel", "tabs", "nativeMessaging"],
  "host_permissions": ["https://neture.co.kr/*"],
  "content_scripts": [
    {
      "matches": ["https://neture.co.kr/*"],
      "js": ["src/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
